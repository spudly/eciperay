{
  "name": "@eciperay/mcp-server",
  "version": "1.31.0",
  "private": true,
  "type": "module",
  "description": "Model Context Protocol server exposing Eciperay recipe management tools",
  "exports": {
    ".": "./src/index.ts",
    "./http": "./src/http.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "tsx --test src/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
