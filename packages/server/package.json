{
  "name": "@eciperay/server",
  "version": "1.26.11",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings --max-old-space-size=4096' jest",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules --no-warnings --max-old-space-size=4096' jest --coverage",
    "test:coverage:ci": "NODE_OPTIONS='--experimental-vm-modules --no-warnings --max-old-space-size=4096' jest --coverage --coverageDirectory=coverage/shard-${JEST_SHARD_INDEX} --shard=${JEST_SHARD_INDEX}/${JEST_SHARD_TOTAL}",
    "test:coverage:merge": "tsx scripts/mergeCoverage.ts",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@eciperay/client": "*",
    "@eciperay/mcp-server": "*",
    "@eciperay/types": "*",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@supabase/supabase-js": "^2.118.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "posthog-node": "^5.56.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "nock": "^14.0.15",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
