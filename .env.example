# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-key

# OpenAI (recipe image generation)
OPENAI_API_KEY=your-openai-key
# Optional: gpt-image-1-mini (default), gpt-image-1, gpt-image-1.5, dall-e-3
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Server
PORT=8080
NODE_ENV=development
# Comma-separated browser origins allowed to call the API (dev: Vite on 8081)
CORS_ORIGINS=http://localhost:8081
# Production example: CORS_ORIGINS=https://eciperay.com,https://www.eciperay.com

# App (Metro @env shim — development / Metro debug)
API_BASE_URL=http://localhost:8080/api

# Web (Vite — must be prefixed VITE_)
VITE_PORT=8081
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL="$SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="$SUPABASE_ANON_KEY"
# PostHog (optional — analytics no-ops when unset)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# App (Metro @env shim — optional PostHog keys)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com