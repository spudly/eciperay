# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-key

# OpenAI (recipe image generation)
OPENAI_API_KEY=your-openai-key
# Optional: gpt-image-1-mini (default), gpt-image-1, gpt-image-1.5, dall-e-3
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Server
PORT=8080
NODE_ENV=development
# Pino log level (default: debug in development, info in production, silent in tests)
# LOG_LEVEL=debug
# Comma-separated browser origins allowed to call the API (dev: Vite on 8081)
CORS_ORIGINS=http://localhost:8081
# Production example: CORS_ORIGINS=https://eciperay.com,https://www.eciperay.com

# App (Metro @env shim — development / Metro debug)
API_BASE_URL=http://localhost:8080/api

# Web (Vite — must be prefixed VITE_)
VITE_PORT=8081
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL="$SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="$SUPABASE_ANON_KEY"

# PostHog (optional — analytics no-ops when unset; shared by web, app, and server)
VITE_POSTHOG_KEY=
# Ingest via reverse proxy in production (e.g. https://a.eciperay.com)
VITE_POSTHOG_HOST=https://a.eciperay.com

# App + server PostHog (Metro @env shim for app; server reads at runtime)
POSTHOG_KEY=
POSTHOG_HOST=https://a.eciperay.com

# PostHog source map upload (CI / production Docker builds only)
# Personal API key with error tracking write access — not the project API key above
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
# PostHog app API — not the ingest proxy; used by source map upload in CI/Docker
POSTHOG_API_HOST=https://us.posthog.com
# Mobile CI uses POSTHOG_CLI_API_KEY and POSTHOG_CLI_PROJECT_ID (same values)